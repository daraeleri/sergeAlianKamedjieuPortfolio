# Copy to .env.local and fill in. Never commit .env.local.

# Public URL of the site (used for metadata, sitemap, OG images)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Neon Postgres (https://neon.tech). Pooled connection for the app ("-pooler" in the
# host), direct connection for migrations.
DATABASE_URL=
DIRECT_URL=

# Random secret mixed into visitor hashes (analytics without cookies).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ANALYTICS_SALT=
