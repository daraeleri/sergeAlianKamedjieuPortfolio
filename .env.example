# Copy to .env.local and fill in. Never commit .env.local.

# Public URL of the site (used for metadata, sitemap, OG images)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Neon Postgres (https://neon.tech). Pooled connection for the app ("-pooler" in the
# host), direct connection for migrations.
DATABASE_URL=
DIRECT_URL=

# Random secret mixed into visitor hashes (analytics without cookies).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ANALYTICS_SALT=

# Email (newsletter and notifications) through Resend (https://resend.com).
# Without RESEND_API_KEY nothing is sent; in development emails print to the server log.
RESEND_API_KEY=
# Sender on a domain verified in Resend, e.g. "Serge Alain Kamedjieu <news@your-domain.com>".
# Until a domain is verified, Resend only delivers to your own account's address.
EMAIL_FROM=
# Where the author's notifications go (new messages, subscribers, send reports).
# Defaults to the contact email in src/config/site.ts.
AUTHOR_EMAIL=
# Language of the author's notifications: en or fr.
AUTHOR_LOCALE=en
