# Copy to .env.local and fill in. Never commit .env.local.

# Public URL of the site (used for metadata, sitemap, OG images)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Neon Postgres (https://neon.tech). Pooled connection for the app ("-pooler" in the
# host), direct connection for migrations.
DATABASE_URL=
DIRECT_URL=

# Random secret mixed into visitor hashes (analytics without cookies).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ANALYTICS_SALT=

# Email (newsletter and notifications). Brevo (https://www.brevo.com) is used when
# BREVO_API_KEY is set (free plan: 300 emails a day); Resend when only RESEND_API_KEY is.
# Without a key nothing is sent; in development emails print to the server log.
# Brevo: Settings > SMTP & API > API keys.
BREVO_API_KEY=
RESEND_API_KEY=
# Sender, e.g. "Serge Alain Kamedjieu <news@your-domain.com>". It must be a sender verified
# in Brevo (Senders, domains & dedicated IPs). A domain you own, authenticated in Brevo,
# keeps emails out of spam better than a Gmail address.
EMAIL_FROM=
# Where the author's notifications go (new messages, subscribers, send reports).
# Defaults to the contact email in src/config/site.ts.
AUTHOR_EMAIL=
# Language of the author's notifications: en or fr.
AUTHOR_LOCALE=en
